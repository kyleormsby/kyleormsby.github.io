---
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Kyle Ormsby — homotopy theory, combinatorics, and mathematical visualization.', wide = false } = Astro.props;
const here = Astro.url.pathname;

const nav = [
  { href: '/research/', label: 'research' },
  { href: '/teaching/', label: 'teaching' },
  { href: '/viz/', label: 'visualizations' },
  { href: '/writing/', label: 'writing' },
];

const isCurrent = (href: string) => here === href || (href !== '/' && here.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="Kyle Ormsby" href="/rss.xml" />

    <script is:inline>
      /* Runs before first paint. Anything deferred here shows the wrong
         palette for a frame on every single page load.
         Light is the default outright — the OS preference is deliberately not
         consulted, because the site is designed light and dark is the option. */
      (function () {
        var KEY = 'theme';                 // 'dark' when chosen; absent = light
        var root = document.documentElement;
        try {
          if (localStorage.getItem(KEY) === 'dark') root.dataset.theme = 'dark';
        } catch (e) { /* private mode, embedded webview: stay light */ }

        window.__theme = {
          isDark: function () { return root.dataset.theme === 'dark'; },
          set: function (dark) {
            if (dark) {
              root.dataset.theme = 'dark';
              try { localStorage.setItem(KEY, 'dark'); } catch (e) {}
            } else {
              delete root.dataset.theme;
              try { localStorage.removeItem(KEY); } catch (e) {}
            }
            document.dispatchEvent(new CustomEvent('themechange'));
          },
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <div class="wrap">
      <header class="site-head">
        <a class="home" href="/">kyle ormsby</a>
        <nav>
          {nav.map((n) => (
            <a class="label" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
          <button
            type="button"
            class="theme-switch"
            role="switch"
            aria-checked="false"
            aria-label="Dark mode"
            data-theme-toggle
            hidden
          >
            <span class="label">dark</span>
            <span class="track" aria-hidden="true"><span class="knob"></span></span>
          </button>
        </nav>
      </header>
    </div>

    <main id="main" class={wide ? 'wrap' : 'prose'}>
      <slot />
    </main>

    <div class="wrap">
      <footer class="site-foot">
        <span class="label">e-infinity.space</span>
        <span class="spacer"></span>
        <a class="label" href="/bio/">bio</a>
        <a class="label" href="mailto:kyle@e-infinity.space">email</a>
        {/* An author-identifier URL (arxiv.org/a/ormsby_k_1) was here, but no
            identifier had been claimed, so it 404'd on every page. Search by
            author works today; swap it back the moment the identifier exists —
            it is the better link, being an exact match rather than a name
            string that can catch a different K. Ormsby. */}
        <a class="label" href="https://arxiv.org/search/math?searchtype=author&query=Ormsby,+K">arxiv</a>
        <a class="label" href="https://github.com/kyleormsby">github</a>
      </footer>
    </div>
    <script>
      /* A two-state switch. There is no 'auto': light is the design, dark is
         the option, and the OS preference is not consulted. */
      const button = document.querySelector('[data-theme-toggle]');
      const theme = (window as any).__theme;

      if (button && theme) {
        const paint = () => button.setAttribute('aria-checked', String(theme.isDark()));
        button.addEventListener('click', () => { theme.set(!theme.isDark()); paint(); });
        paint();
        button.removeAttribute('hidden');
      }
    </script>
  </body>
</html>
