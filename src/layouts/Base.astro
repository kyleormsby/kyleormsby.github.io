---
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Kyle Ormsby — homotopy theory, combinatorics, and mathematical visualization.', wide = false } = Astro.props;
const here = Astro.url.pathname;

const nav = [
  { href: '/research/', label: 'research' },
  { href: '/teaching/', label: 'teaching' },
  { href: '/viz/', label: 'visualizations' },
  { href: '/writing/', label: 'writing' },
];

const isCurrent = (href: string) => here === href || (href !== '/' && here.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="Kyle Ormsby" href="/rss.xml" />

    <script is:inline>
      /* Runs before first paint. Anything deferred here shows the wrong
         palette for a frame on every single page load. */
      (function () {
        var KEY = 'theme';                 // 'light' | 'dark'; absent = follow the OS
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem(KEY);
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch (e) { /* private mode, embedded webview: just follow the OS */ }

        window.__theme = {
          get: function () { return root.dataset.theme || 'auto'; },
          set: function (mode) {
            if (mode === 'auto') {
              delete root.dataset.theme;
              try { localStorage.removeItem(KEY); } catch (e) {}
            } else {
              root.dataset.theme = mode;
              try { localStorage.setItem(KEY, mode); } catch (e) {}
            }
            document.dispatchEvent(new CustomEvent('themechange', { detail: mode }));
          },
        };
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>
    <div class="wrap">
      <header class="site-head">
        <a class="home" href="/">kyle ormsby</a>
        <nav>
          {nav.map((n) => (
            <a class="label" href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
          <button type="button" class="theme-toggle" data-theme-toggle hidden>auto</button>
        </nav>
      </header>
    </div>

    <main id="main" class={wide ? 'wrap' : 'prose'}>
      <slot />
    </main>

    <div class="wrap">
      <footer class="site-foot">
        <span class="label">configuration.space</span>
        <span class="spacer"></span>
        <a class="label" href="mailto:kyle@configuration.space">email</a>
        <a class="label" href="https://arxiv.org/a/ormsby_k_1">arxiv</a>
        <a class="label" href="https://github.com/kyleormsby">github</a>
      </footer>
    </div>
    <script>
      /* Cycles auto -> light -> dark -> auto. 'auto' is a real state, not a
         placeholder: without it the first click would permanently opt out of
         following the OS, which is the wrong default for anyone whose desktop
         switches at sunset. */
      const button = document.querySelector('[data-theme-toggle]');
      const theme = (window as any).__theme;

      if (button && theme) {
        const ORDER = ['auto', 'light', 'dark'];
        const DESCRIPTION = {
          auto: 'following your system setting',
          light: 'always light',
          dark: 'always dark',
        };

        const paint = () => {
          const mode = theme.get();
          button.textContent = mode;
          button.setAttribute(
            'aria-label',
            `Colour scheme: ${DESCRIPTION[mode as keyof typeof DESCRIPTION]}. Activate to change.`,
          );
        };

        button.addEventListener('click', () => {
          theme.set(ORDER[(ORDER.indexOf(theme.get()) + 1) % ORDER.length]);
          paint();
        });

        paint();
        button.removeAttribute('hidden');
      }
    </script>
  </body>
</html>
