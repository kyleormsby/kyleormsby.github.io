---
import Base from '../../layouts/Base.astro';
import { allCourses, courseHref } from '../../lib/courses';

const courses = allCourses();
const current = courses.filter((c) => c.current);
const past = courses.filter((c) => !c.current);
---

<Base title="Teaching · Kyle Ormsby">
  <p class="label">teaching</p>
  <h1>Courses</h1>
  <p class="lede dim" style="margin-top:var(--s4)">
    Every course page is generated from a spreadsheet — one row per class
    meeting. Readings, worksheets, and homework links stay in sync because there
    is only one place to edit them.
  </p>

  {current.length > 0 && (
    <>
      <h2 class="rule-label"><span class="label">this term</span></h2>
      <section>
        {current.map((c) => (
          <div class="entry">
            <span class="label">{c.term}</span>
            <div>
              <a href={courseHref(c)}>{c.number} · {c.title}</a>
              {c.blurb && <p class="dim" style="margin:var(--s1) 0 0;font-size:0.94rem">{c.blurb}</p>}
            </div>
          </div>
        ))}
      </section>
    </>
  )}

  <h2 class="rule-label"><span class="label">previously</span></h2>
  <section>
    {past.map((c) => (
      <div class="entry">
        <span class="label">{c.term}</span>
        <div>
          <a href={courseHref(c)}>{c.number} · {c.title}</a>
          {c.blurb && <p class="dim" style="margin:var(--s1) 0 0;font-size:0.94rem">{c.blurb}</p>}
        </div>
      </div>
    ))}
  </section>
</Base>
