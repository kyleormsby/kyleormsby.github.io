{
  "name": "configuration-space",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "thumbs": "node tools/thumbnails.mjs",
    "course:import": "python3 tools/import_course.py",
    "shots": "node tools/shots.mjs",
    "research:import": "python3 tools/import_research.py",
    "vendor": "node tools/vendor_three.mjs && node tools/vendor_fonts.mjs",
    "vendor:check": "node tools/vendor_three.mjs --check && node tools/vendor_fonts.mjs --check",
    "files:sync": "bash tools/sync_files.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.1.6",
    "katex": "^0.18.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "three": "0.128.0",
    "three-160": "npm:three@^0.160.0"
  }
}
